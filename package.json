{
	"name": "@sinehypernova-0718/n8n-nodes-coolify",
	"version": "0.1.2",
	"packageManager": "pnpm@12.4.2",
	"description": "An n8n community node for managing Coolify applications, deployments, databases, services, and infrastructure through workflows.",
	"license": "MIT",
	"homepage": "https://github.com/sinehypernova-0718/n8n-nodes-coolify#readme",
	"keywords": [
		"n8n",
		"n8n-community-node",
		"n8n-community-node-package",
		"n8n-nodes",
		"n8n-nodes-coolify",
		"coolify",
		"coolify-api",
		"self-hosted",
		"self-hosting",
		"deployment",
		"devops",
		"server-management",
		"application-management",
		"cloud-init",
		"audit-logs",
		"automation",
		"workflow-automation",
		"continuous-deployment",
		"infrastructure",
		"platform-engineering",
		"api-integration"
	],
	"author": {
		"name": "sinehypernova-0718",
		"email": "srinjoy875@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sinehypernova-0718/n8n-nodes-coolify.git"
	},
	"bugs": {
		"url": "https://github.com/sinehypernova-0718/n8n-nodes-coolify/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"release:local": "release-it",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CoolifyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Coolify/Coolify.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^22.20.5",
		"eslint": "9.29.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "^4.1.12"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
